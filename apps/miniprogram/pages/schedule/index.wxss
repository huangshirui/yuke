.schedule-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.schedule-header .text-button{width:auto;white-space:nowrap}.view-switch{display:grid;grid-template-columns:1fr 1fr;gap:8rpx;margin-bottom:24rpx;padding:6rpx;border-radius:14rpx;background:#e9eeef}.view-switch__item{min-height:68rpx;margin:0;border:0;border-radius:10rpx;background:transparent;color:#68747f;font-size:26rpx;font-weight:600;line-height:68rpx}.view-switch__item::after{border:0}.view-switch__item--active{background:#fff;color:#17202a}.calendar-toolbar,.three-toolbar{display:grid;grid-template-columns:64rpx 1fr 64rpx auto;align-items:center;gap:12rpx;margin-bottom:16rpx}.three-toolbar{grid-template-columns:64rpx 1fr 64rpx}.calendar-nav,.calendar-expand{margin:0;border:1rpx solid #e3e8eb;background:#fff;color:#17202a}.calendar-nav{width:64rpx;height:64rpx;padding:0;border-radius:32rpx;font-size:38rpx;line-height:62rpx}.calendar-expand{min-height:64rpx;padding:0 20rpx;border-radius:12rpx;font-size:24rpx}.calendar-nav::after,.calendar-expand::after{border:0}.calendar-range{text-align:center;color:#68747f;font-size:24rpx}.calendar-weekdays{display:grid;grid-template-columns:repeat(7,1fr);padding:0 8rpx;color:#98a2b3;font-size:22rpx;text-align:center}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8rpx;margin-top:10rpx}.calendar-day{position:relative;min-height:78rpx;margin:0;padding:8rpx;border:1rpx solid #e7eaf0;border-radius:12rpx;background:#fff;color:#17202a;line-height:1}.calendar-day::after{border:0}.calendar-day--selected{border-color:#126e62;background:#e8f4f1;color:#126e62}.calendar-day--muted{color:#a8b0b7;background:#fafbfb}.calendar-day__number{font-size:26rpx}.calendar-day__count{position:absolute;right:8rpx;bottom:7rpx;min-width:28rpx;height:28rpx;padding:0 5rpx;border-radius:14rpx;background:#126e62;color:#fff;font-size:18rpx;line-height:28rpx}.selected-day{margin-top:32rpx}.booking-card{box-sizing:border-box;width:100%;margin:0 0 16rpx;padding:22rpx 24rpx;display:flex;align-items:center;justify-content:space-between;text-align:left;border:1rpx solid #e3e8eb;background:#fff}.booking-card::after{border:0}.booking-card__main{display:grid;gap:7rpx}.booking-card__title{display:flex;align-items:center;gap:12rpx;font-size:28rpx;font-weight:600}.booking-card__resource{font-size:25rpx;color:#17202a}.status-badge{display:inline-flex;align-items:center;min-height:34rpx;padding:0 10rpx;border-radius:999rpx;font-size:20rpx;font-weight:600}.status-badge--booked{background:#e8f4f1;color:#126e62}.status-badge--completed{background:#eef1f2;color:#5f6b75}.status-badge--cancelled{background:#fff0ef;color:#b43c3c}.three-grid{display:grid;gap:20rpx}.three-day{padding:22rpx;border:1rpx solid #e3e8eb;border-radius:16rpx;background:#fff}.three-day__title{display:block;margin-bottom:16rpx;font-size:28rpx;font-weight:600}.three-empty{padding:28rpx 0;color:#98a2b3;text-align:center}.booking-card--compact{padding:18rpx;background:#f9fbfb}.booking-card--compact:last-child{margin-bottom:0}.state-card{margin-top:12rpx}.chevron{color:#98a2b3;font-size:40rpx}
