.detail-card { display: grid; gap: 0; }
.detail-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2-5); padding-bottom: var(--space-3); border-bottom: 1rpx solid var(--color-line-soft); }
.detail-resource { color: var(--color-ink); font-size: 34rpx; font-weight: 600; }
.detail-row { display: grid; gap: var(--space-1); padding: var(--space-3) 0; border-bottom: 1rpx solid var(--color-line-soft); }
.detail-row:last-child { border-bottom: 0; }
.detail-label { color: var(--color-subtle); font-size: 22rpx; }
.cancel-button { margin-top: var(--space-3-5); }
.state-note { margin-top: var(--space-3); text-align: center; }
