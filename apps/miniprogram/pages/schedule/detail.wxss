.detail-card{display:grid;gap:0}.detail-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding-bottom:24rpx;border-bottom:1rpx solid #e7eaf0}.detail-resource{display:block;margin-bottom:7rpx;font-size:34rpx;font-weight:600}.detail-type{font-size:24rpx;color:#68747f}.detail-row{display:grid;gap:8rpx;padding:24rpx 0;border-bottom:1rpx solid #e7eaf0}.detail-row:last-child{border-bottom:0}.detail-label{font-size:22rpx;color:#98a2b3}.detail-id{font-family:monospace;font-size:22rpx;color:#68747f;word-break:break-all}.status-badge{display:inline-flex;align-items:center;min-height:38rpx;padding:0 12rpx;border-radius:999rpx;font-size:22rpx;font-weight:600}.status-badge--booked{background:#e8f4f1;color:#126e62}.status-badge--completed{background:#eef1f2;color:#5f6b75}.status-badge--cancelled{background:#fff0ef;color:#b43c3c}.cancel-button{width:100%;min-height:88rpx;margin-top:28rpx;border:1rpx solid #efc9c5;border-radius:16rpx;background:#fff;color:#b43c3c;font-size:28rpx;font-weight:600;line-height:86rpx}.cancel-button::after{border:0}.state-note{margin-top:24rpx;text-align:center}
