.profile-summary {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--color-accent-soft);
}

.profile-avatar--empty {
  color: var(--color-accent);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 104rpx;
  text-align: center;
}

.profile-copy {
  flex: 1;
  margin-left: 24rpx;
}

.profile-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.chevron {
  color: var(--color-subtle);
  font-size: 40rpx;
}

.account-section {
  margin-top: 40rpx;
}

.account-list {
  overflow: hidden;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 112rpx;
  padding: var(--space-2) var(--space-4);
  border-bottom: 1rpx solid var(--color-line-soft);
}

.account-row:last-child {
  border-bottom: 0;
}

.account-row__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.account-row__title {
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 600;
}
