<view class="page">
  <view class="profile-summary card" bindtap="editProfile">
    <image wx:if="{{avatarDisplayUrl}}" class="profile-avatar" src="{{avatarDisplayUrl}}" mode="aspectFill" />
    <view wx:else class="profile-avatar profile-avatar--empty">Yu</view>
    <view class="profile-copy">
      <text class="profile-name">{{user.nickname || '未设置昵称'}}</text>
      <text class="caption">点击编辑资料</text>
    </view>
    <text class="chevron">›</text>
  </view>

  <view class="account-section">
    <text class="section-title">预约设置</text>
    <view class="list-surface account-list">
      <view class="list-row account-row" bindtap="manageParticipants" role="button">
        <view class="account-row__copy">
          <text class="account-row__title">常用预约人</text>
          <text class="caption">管理为家人或他人预约时使用的信息</text>
        </view>
        <text class="chevron">›</text>
      </view>
      <view class="list-row account-row" bindtap="manageSpaces" role="button">
        <view class="account-row__copy">
          <text class="account-row__title">服务方</text>
          <text class="caption">{{currentSpace ? currentSpace.name : (spaces.length ? '请选择服务方' : '尚未加入服务方')}}</text>
        </view>
        <text class="chevron">›</text>
      </view>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
