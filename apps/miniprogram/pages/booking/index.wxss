.booking-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.booking-header .text-button{width:auto;white-space:nowrap}.resource-strip{display:flex;white-space:nowrap;margin-bottom:24rpx}.resource-chip{display:inline-flex;margin-right:12rpx;padding:14rpx 22rpx;border:1rpx solid #e3e8eb;border-radius:999rpx;background:#fff;color:#68747f;font-size:26rpx;line-height:1.2}.resource-chip--active{border-color:#126e62;background:#e8f4f1;color:#126e62;font-weight:600}.slot-groups{display:grid;gap:28rpx}.slot-day{display:grid;gap:14rpx}.slot-list{display:grid;gap:12rpx}.slot-card{width:100%;margin:0;display:flex;align-items:center;justify-content:space-between;text-align:left;padding:24rpx;border:1rpx solid #e3e8eb;background:#fff}.slot-card::after{border:0}.slot-time{display:grid;gap:8rpx;font-size:30rpx;font-weight:600}.slot-type{font-size:24rpx;color:#68747f;font-weight:400}.state-card{margin-top:12rpx}.confirm-backdrop{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end;background:rgba(12,25,23,.42)}.confirm-sheet{box-sizing:border-box;width:100%;max-height:82vh;overflow:auto;padding:32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;background:#fff}.confirm-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding-bottom:24rpx;border-bottom:1rpx solid #e7eaf0}.confirm-heading .section-title{margin-bottom:8rpx}.confirm-time{display:block;margin-bottom:8rpx;font-size:30rpx;font-weight:600}.confirm-close{width:64rpx;height:64rpx;margin:0;padding:0;border:0;border-radius:32rpx;background:#f0f3f4;color:#68747f;font-size:38rpx;line-height:64rpx}.confirm-close::after{border:0}.confirm-state{padding:32rpx 0}.confirm-state .secondary-button{margin-top:24rpx}.participant-picker{padding-top:28rpx}.participant-option{box-sizing:border-box;width:100%;min-height:96rpx;margin:0 0 16rpx;padding:20rpx 22rpx;display:flex;align-items:center;justify-content:space-between;text-align:left;border:1rpx solid #e3e8eb;border-radius:14rpx;background:#fff}.participant-option::after{border:0}.participant-option--active{border-color:#126e62;background:#f3faf8}.participant-name{display:block;margin-bottom:6rpx;font-size:28rpx;font-weight:600}.participant-check{color:#126e62;font-size:32rpx;font-weight:700}.confirm-action{margin-top:24rpx}
