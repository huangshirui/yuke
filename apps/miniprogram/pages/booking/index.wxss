.resource-strip{display:flex;white-space:nowrap;margin-bottom:24rpx}.resource-chip{display:inline-flex;margin-right:12rpx;padding:14rpx 22rpx;border:1rpx solid #e3e8eb;border-radius:999rpx;background:#fff;color:#68747f;font-size:26rpx;line-height:1.2}.resource-chip--active{border-color:#126e62;background:#e8f4f1;color:#126e62;font-weight:600}.slot-groups{display:grid;gap:28rpx}.slot-day{display:grid;gap:14rpx}.slot-list{display:grid;gap:12rpx}.slot-card{width:100%;margin:0;display:flex;align-items:center;justify-content:space-between;text-align:left;padding:24rpx;border:1rpx solid #e3e8eb;background:#fff}.slot-card::after{border:0}.slot-time{display:grid;gap:8rpx;font-size:30rpx;font-weight:600}.slot-type{font-size:24rpx;color:#68747f;font-weight:400}.state-card{margin-top:12rpx}
