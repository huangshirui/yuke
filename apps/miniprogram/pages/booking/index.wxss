.booking-title-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.booking-title-row .text-button { flex: none; min-height: 48rpx; white-space: nowrap; }
.resource-section { margin-bottom: var(--space-3); }
.resource-section .field-label { margin-bottom: var(--space-2); }
.resource-strip { display: flex; white-space: nowrap; }
.resource-chip { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; box-sizing: border-box; width: auto; min-width: 152rpx; max-width: 280rpx; margin: 0 var(--space-1-5) 0 0; padding: 14rpx 22rpx; overflow: hidden; border: 1rpx solid var(--color-line); border-radius: var(--radius-round); background: var(--color-surface); color: var(--color-muted); font-size: 26rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.resource-chip::after { border: 0; }
.resource-chip--active { border-color: var(--color-accent); background: var(--color-accent-soft); color: var(--color-accent); font-weight: 600; }
.slot-groups { display: grid; gap: var(--space-3-5); }
.slot-day { display: grid; gap: 14rpx; }
.slot-list { display: block; }
.slot-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-2); margin: 0; padding: var(--space-3) var(--space-4); border: 0; border-bottom: 1rpx solid var(--color-line-soft); border-radius: 0; text-align: left; }
.slot-card:last-child { border-bottom: 0; }
.slot-card::after { border: 0; }
.slot-card--unavailable { background: var(--color-line-soft); color: var(--color-subtle); }
.slot-time { min-width: 0; font-size: var(--font-section); font-weight: 600; text-align: left; }
.slot-availability { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; height: 44rpx; padding: 0 14rpx; border-radius: var(--radius-round); background: var(--color-surface); color: var(--color-muted); font-size: 22rpx; font-weight: 600; line-height: 1; }
.state-card { margin-top: var(--space-1-5); }
.confirm-backdrop { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: var(--color-overlay); }
.confirm-sheet { box-sizing: border-box; width: 100%; max-height: 82vh; overflow: auto; padding: var(--space-4) var(--page-gutter) calc(var(--space-4) + env(safe-area-inset-bottom)); border-radius: var(--radius-sheet) var(--radius-sheet) 0 0; background: var(--color-surface); }
.confirm-heading { display: flex; align-items: flex-start; gap: var(--space-3); padding-bottom: var(--space-3); border-bottom: 1rpx solid var(--color-line-soft); }
.confirm-heading__copy { flex: 1; min-width: 0; }
.confirm-heading .section-title { margin-bottom: var(--space-1); }
.confirm-time { display: block; margin-bottom: var(--space-1); font-size: var(--font-section); font-weight: 600; }
.confirm-close { display: block; flex: 0 0 64rpx; box-sizing: border-box; width: 64rpx; min-width: 64rpx; max-width: 64rpx; height: 64rpx; min-height: 64rpx; max-height: 64rpx; margin: 0; padding: 0; border: 0; border-radius: var(--radius-round); background: var(--color-line-soft); color: var(--color-muted); font-size: 38rpx; line-height: 64rpx; }
.confirm-close::after { border: 0; }
.confirm-state { padding: var(--space-4) 0; }
.confirm-state .secondary-button { margin-top: var(--space-3); }
.participant-picker { padding-top: var(--space-3-5); }
.participant-option { display: grid; grid-template-columns: minmax(0, 1fr) 48rpx; align-items: center; box-sizing: border-box; width: 100%; min-height: 96rpx; margin: 0 0 var(--space-2); padding: var(--space-2-5) 22rpx; border: 1rpx solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-surface); text-align: left; }
.participant-option::after { border: 0; }
.participant-option--active { border-color: var(--color-accent); background: var(--color-accent-soft); }
.participant-name { display: block; margin-bottom: 6rpx; font-size: var(--font-body); font-weight: 600; }
.participant-check { color: var(--color-accent); font-size: 32rpx; font-weight: 700; }
.confirm-action { box-sizing: border-box; width: 100%; max-width: none; margin: var(--space-3) 0 0; }
