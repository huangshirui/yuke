.profile-card {
  padding-top: 40rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-button {
  display: block;
  flex: 0 0 152rpx;
  box-sizing: border-box;
  width: 152rpx;
  min-width: 152rpx;
  max-width: 152rpx;
  height: 152rpx;
  min-height: 152rpx;
  max-height: 152rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-round);
  background: var(--color-accent-soft);
  overflow: hidden;
  line-height: 1;
}

.avatar-button::after {
  border: 0;
}

.avatar-image {
  display: block;
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--radius-round);
}

.avatar-placeholder {
  width: 152rpx;
  height: 152rpx;
  color: var(--color-accent);
  font-size: var(--font-caption);
  line-height: 152rpx;
  text-align: center;
}

.avatar-section .caption {
  margin-top: 16rpx;
}

.nickname-field {
  margin-top: 40rpx;
}

.submit-button {
  margin-top: 32rpx;
}
