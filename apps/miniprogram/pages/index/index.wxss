.bootstrap-page {
  text-align: center;
}

.bootstrap-content {
  width: 100%;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  border-radius: 36rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-brand);
}

.brand-logo {
  width: 132rpx;
  height: 132rpx;
}

.bootstrap-title {
  display: block;
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.retry-button {
  margin-top: 32rpx;
}
