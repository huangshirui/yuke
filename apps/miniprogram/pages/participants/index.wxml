<view class="page">
  <view class="page-header page-header--action">
    <view class="page-header__copy">
      <text class="page-title">常用预约人</text>
      <text class="page-description">
        {{hasSpace ? currentSpace.name + ' · ' + activeCount + '/' + participants.length + ' 位可使用' : '管理为家人或他人预约时使用的信息。'}}
      </text>
    </view>
    <button wx:if="{{hasSpace}}" class="header-action" bindtap="addParticipant">新增</button>
  </view>

  <view wx:if="{{!hasSpace}}" class="card state-card">
    <text class="state-title">还没有可用的服务方</text>
    <text class="page-description">先加入或选择服务方，才能管理常用预约人。</text>
    <button class="primary-button empty-action" bindtap="goToSpaces">选择服务方</button>
  </view>

  <view wx:elif="{{loading}}" class="card state-card">
    <text class="muted">正在加载预约人…</text>
  </view>

  <view wx:elif="{{!participants.length}}" class="card state-card">
    <text class="state-title">还没有常用预约人</text>
    <text class="page-description">新增后，发起预约时即可直接选择“为谁预约”。</text>
    <button class="primary-button empty-action" bindtap="addParticipant">新增预约人</button>
  </view>

  <view wx:else class="list-surface participant-list">
    <view wx:for="{{participants}}" wx:key="id" class="list-row participant-card">
      <view class="participant-card__main">
        <view class="participant-card__heading">
          <text class="participant-name">{{item.name}}</text>
          <view class="status-badge {{item.status === 'active' ? 'status-badge--active' : 'status-badge--inactive'}}">
            <text class="status-badge__label">{{item.status === 'active' ? '可使用' : '已停用'}}</text>
          </view>
        </view>
        <text class="participant-meta">出生年月 {{item.birthMonth}}</text>
        <text wx:if="{{item.note}}" class="participant-note">{{item.note}}</text>
      </view>

      <view class="participant-actions">
        <button
          class="text-button participant-action"
          data-participant-id="{{item.id}}"
          bindtap="editParticipant"
        >编辑</button>
        <button
          class="text-button participant-action {{item.status === 'active' ? 'participant-action--danger' : ''}}"
          loading="{{actionParticipantId === item.id}}"
          disabled="{{actionParticipantId === item.id}}"
          data-participant-id="{{item.id}}"
          data-status="{{item.status}}"
          bindtap="toggleParticipant"
        >{{item.status === 'active' ? '停用' : '启用'}}</button>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
