.participant-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.participant-header__copy {
  flex: 1;
}

.participant-add {
  min-width: 120rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 14rpx;
  background: #126e62;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.participant-list .participant-card + .participant-card {
  margin-top: 20rpx;
}

.participant-card {
  padding-bottom: 16rpx;
}

.participant-card__heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.participant-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #17202a;
}

.status-badge {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.status-badge--active {
  background: #e8f4f1;
  color: #126e62;
}

.status-badge--inactive {
  background: #f0f2f5;
  color: #667085;
}

.participant-meta {
  display: block;
  margin-top: 14rpx;
  color: #667085;
  font-size: 24rpx;
}

.participant-note {
  display: block;
  margin-top: 12rpx;
  color: #475467;
  font-size: 26rpx;
  line-height: 1.55;
}

.participant-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #eef0f3;
}

.participant-action {
  width: auto;
  margin: 0;
  min-height: 64rpx;
  line-height: 64rpx;
}

.participant-action--danger {
  color: #b43c3c;
}

.state-card {
  text-align: center;
}

.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.state-card .page-description {
  margin-top: 12rpx;
}

.empty-action {
  margin-top: 28rpx;
}
