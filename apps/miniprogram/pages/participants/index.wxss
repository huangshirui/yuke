.participant-card {
  padding: var(--space-3) var(--space-4) var(--space-2);
}

.participant-card__heading {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.participant-card__main {
  min-width: 0;
}

.participant-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.participant-meta {
  display: block;
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.participant-note {
  display: block;
  margin-top: 12rpx;
  color: var(--color-ink);
  font-size: 26rpx;
  line-height: 1.55;
}

.participant-actions {
  display: flex;
  justify-content: flex-start;
  gap: var(--space-4);
  margin-top: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-line-soft);
}

.participant-action {
  flex: 0 0 104rpx;
  width: 104rpx;
  min-width: 104rpx;
  max-width: 104rpx;
  margin: 0;
  min-height: 64rpx;
  line-height: 64rpx;
}

.participant-action--danger {
  color: var(--color-danger);
}
