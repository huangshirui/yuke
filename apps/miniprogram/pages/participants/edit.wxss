.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value--placeholder {
  color: var(--color-subtle);
}

.picker-chevron {
  color: var(--color-subtle);
  font-size: 38rpx;
}

.note-input {
  min-height: 160rpx;
  line-height: 1.55;
}

.field-helper {
  display: block;
  margin-top: 10rpx;
  color: var(--color-subtle);
  font-size: 22rpx;
  line-height: 1.5;
}

.submit-button {
  margin-top: 32rpx;
}

.form-state {
  text-align: center;
}

.state-card {
  text-align: center;
}

.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.state-card .page-description {
  margin-top: 12rpx;
}

.empty-action {
  margin-top: 28rpx;
}
