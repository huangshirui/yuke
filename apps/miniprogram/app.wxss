page {
  background: #f6f7f9;
  color: #17202a;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.page--centered {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #17202a;
}

.page-description {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #667085;
}

.card {
  box-sizing: border-box;
  padding: 32rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 16rpx;
  background: #ffffff;
}

.card + .card {
  margin-top: 24rpx;
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #17202a;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #667085;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #17202a;
}

.primary-button,
.secondary-button {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-button {
  border: none;
  background: #126e62;
  color: #ffffff;
}

.primary-button[disabled] {
  background: #aacbc5;
  color: #ffffff;
}

.primary-button.button-hover {
  background: #0d5a50;
}

.secondary-button {
  border: 1rpx solid #d7dce5;
  background: #ffffff;
  color: #17202a;
}

.text-button {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #126e62;
  font-size: 26rpx;
}

.muted {
  color: #667085;
}

.caption {
  font-size: 24rpx;
  color: #98a2b3;
}

.stack-24 > view + view,
.stack-24 > button + button {
  margin-top: 24rpx;
}

.safe-bottom {
  height: calc(32rpx + env(safe-area-inset-bottom));
}
